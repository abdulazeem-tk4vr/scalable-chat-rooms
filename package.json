{
  "name": "scalable-chat-rooms",
  "version": "1.0.0",
  "description": "Chat server to accomodate different rooms, namespaces while having a scalable solution",
  "main": "index.js",
  "scripts": {
    "clean": "rmdir /s /q dist && mkdir dist",
    "compile": "tsc -p .",
    "prepare": "npm run clean && npm run compile",
    "lint": "gts check",
    "fix": "gts fix",
    "start": "node dist/src/index.js",
    "server": "node dist/src/server.js",
    "client": "node dist/src/client.js",
    "format-fix": "prettier --write 'src/**/*.{ts,js,json,md}'",
    "format-check": "prettier --check 'src/**/*.{ts,js,json,md}'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulazeem-tk4vr/scalable-chat-rooms.git"
  },
  "keywords": [
    "Redis",
    "Socket.io",
    "Nginx",
    "Cluster"
  ],
  "author": "Abdul Azeem Shaik",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abdulazeem-tk4vr/scalable-chat-rooms/issues"
  },
  "homepage": "https://github.com/abdulazeem-tk4vr/scalable-chat-rooms#readme",
  "devDependencies": {
    "gts": "^6.0.2",
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "ioredis": "^5.6.1",
    "readline": "^1.3.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  }
}
